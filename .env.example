# Supabase Environment Variables for Vercel / Production
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# REQUIRED for production email verification redirects to work correctly.
# Set this in Vercel → Project Settings → Environment Variables
# Example: https://isomer-website.vercel.app
# Also set the same URL in: Supabase → Authentication → URL Configuration → Site URL
VITE_SITE_URL=https://your-vercel-app.vercel.app
